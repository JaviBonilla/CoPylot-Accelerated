diff --git a/solarpilot/CoreProfile.cpp b/solarpilot/CoreProfile.cpp
new file mode 100644
index 000000000..0f3447d49
--- /dev/null
+++ b/solarpilot/CoreProfile.cpp
@@ -0,0 +1,44 @@
+#include "CoreProfile.h"
+#ifdef SOLARPILOT_ENABLE_CORE_PROFILE
+#include <cstdlib>
+#include <fstream>
+#include <iomanip>
+#include <mutex>
+namespace sp_profile {
+thread_local State* active = nullptr;
+thread_local Scope* parent = nullptr;
+static std::mutex output_mutex;
+static const char* names[] = {"API", "PerformanceSimulationPrep", "calcHeliostatShadows",
+ "HermiteFluxSimulation", "AnalyticalFluxSimulation", "CalcDimensionalFluxProfiles",
+ "Flux::fluxDensity", "Flux::imagePlaneIntercept", "UpdateNeighborList", "SolarField::Simulate"};
+Session::Session(const char* phase) : previous_(active), phase_(phase) { active = &state_; }
+Session::~Session() {
+    active = previous_;
+    const char* file = std::getenv("SOLARPILOT_PROFILE_FILE");
+    if (!file || !*file) return;
+    std::lock_guard<std::mutex> lock(output_mutex);
+    std::ofstream out(file, std::ios::app);
+    out << std::setprecision(17);
+    for (int i = 0; i < Count; ++i) {
+        const Entry& e = state_.entries[i];
+        out << phase_ << ',' << names[i] << ',' << e.calls << ',' << e.inclusive << ',' << e.exclusive << '\n';
+    }
+}
+Scope::Scope(Id id) : state_(active), parent_(nullptr), id_(id) {
+    if (!state_) return;
+    parent_ = parent;
+    parent = this;
+    start_ = Clock::now();
+}
+Scope::~Scope() {
+    if (!state_) return;
+    const double elapsed = std::chrono::duration<double>(Clock::now() - start_).count();
+    Entry& e = state_->entries[id_];
+    ++e.calls;
+    e.inclusive += elapsed;
+    e.exclusive += elapsed - children_;
+    if (parent_) parent_->children_ += elapsed;
+    parent = parent_;
+}
+}
+#endif
diff --git a/solarpilot/CoreProfile.h b/solarpilot/CoreProfile.h
new file mode 100644
index 000000000..cd9f8e8f5
--- /dev/null
+++ b/solarpilot/CoreProfile.h
@@ -0,0 +1,42 @@
+#ifndef SOLARPILOT_CORE_PROFILE_H
+#define SOLARPILOT_CORE_PROFILE_H
+// Compile-time opt-in. OFF expands to nothing, including inside hot paths.
+#ifdef SOLARPILOT_ENABLE_CORE_PROFILE
+#include <array>
+#include <chrono>
+#include <cstdint>
+namespace sp_profile {
+enum Id { API, Prep, Shadows, Hermite, Analytical, Dimensional, Density, Intercept,
+          NeighborList, Simulation, Count };
+struct Entry { std::uint64_t calls = 0; double inclusive = 0.; double exclusive = 0.; };
+struct State { std::array<Entry, Count> entries; };
+class Scope;
+extern thread_local State* active;
+extern thread_local Scope* parent;
+class Session {
+    State state_;
+    State* previous_;
+    const char* phase_;
+public:
+    explicit Session(const char* phase);
+    ~Session();
+};
+class Scope {
+    using Clock = std::chrono::steady_clock;
+    State* state_;
+    Scope* parent_;
+    Clock::time_point start_;
+    double children_ = 0.;
+    Id id_;
+public:
+    explicit Scope(Id id);
+    ~Scope();
+};
+}
+#define SP_PROFILE_SCOPE(id) sp_profile::Scope sp_scope_##id(sp_profile::id)
+#define SP_PROFILE_SESSION(phase) sp_profile::Session sp_session(phase)
+#else
+#define SP_PROFILE_SCOPE(id)
+#define SP_PROFILE_SESSION(phase)
+#endif
+#endif
