+
+SPEXPORT int sp_get_compute_backend(sp_data_t p_data)
+{
+    if (!p_data) return -1;
+    return static_cast<int>(static_cast<CopilotObject*>(p_data)->compute.selected);
+}
+
+SPEXPORT bool sp_set_cuda_device(sp_data_t p_data, int device)
+{
+    if (!p_data) return false;
+    auto& state = static_cast<CopilotObject*>(p_data)->compute;
+    state.error.clear();
+    if (device < 0) {
+        state.error = "CUDA device index must be nonnegative";
+        return false;
+    }
+    if (!solarpilot::cuda_probe_device(device, state.error)) return false;
+    if (device != state.cuda_device) state.gpu.reset();
+    state.cuda_device = device;
+    return true;
+}
+
+SPEXPORT bool sp_simulate(sp_data_t p_data, int nthreads, bool update_aimpoints)
+{
+    if (!p_data) return false;
+    auto& state = static_cast<CopilotObject*>(p_data)->compute;
+    state.error.clear();
+    switch (state.selected) {
+    case solarpilot::ComputeBackend::CPU:
+        return simulate_cpu(p_data, nthreads, update_aimpoints);
+    case solarpilot::ComputeBackend::CUDA:
+        state.error = "CUDA backend not implemented yet";
+        return false;
+    }
+    state.error = "Invalid compute backend";
+    return false;
+}
