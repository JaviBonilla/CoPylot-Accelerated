+/* SPDX-License-Identifier: BSD-3-Clause */
+#ifndef SOLARPILOT_IMAGE_PLANE_INTERCEPT_CUDA_H
+#define SOLARPILOT_IMAGE_PLANE_INTERCEPT_CUDA_H
+#include "ImagePlaneIntercept.h"
+#include <array>
+#include <memory>
+namespace solarpilot {
+constexpr int image_plane_block_size = 128; // First correctness implementation; not tuned.
+constexpr std::size_t image_plane_layout_fields = 16;
+using ImagePlaneLayout = std::array<std::uint64_t,image_plane_layout_fields>;
+inline ImagePlaneLayout image_plane_host_layout() {
+    return {{sizeof(image_plane::Input),alignof(image_plane::Input),sizeof(image_plane::Output),alignof(image_plane::Output),
+        sizeof(image_plane::Tables),alignof(image_plane::Tables),offsetof(image_plane::Input,mirror_normalized),
+        offsetof(image_plane::Input,panel_x),offsetof(image_plane::Input,cant_method),offsetof(image_plane::Input,visible),
+        offsetof(image_plane::Output,hermite),offsetof(image_plane::Output,sigma),offsetof(image_plane::Output,intercept),
+        offsetof(image_plane::Output,updated),sizeof(std::int32_t),sizeof(std::uint8_t)}};
+}
+struct ImagePlaneGpuStatistics {
+    std::size_t heliostats=0,input_capacity=0,output_capacity=0,table_capacity=0,allocations=0;
+    std::size_t input_h2d_bytes=0,tables_h2d_bytes=0,output_d2h_bytes=0;
+    bool timed=false;
+    double preparation_s=0.,writeback_s=0.,total_s=0.;
+    double input_h2d_ms=0.,tables_h2d_ms=0.,kernel_ms=0.,d2h_ms=0.;
+};
+struct ImagePlaneGpuResources {
+    int registers=0,max_threads=0,active_blocks_per_sm=0,sm_count=0,warp_size=0,max_threads_per_sm=0;
+    int compute_major=0,compute_minor=0,runtime_version=0,driver_version=0;
+    std::size_t local_bytes=0,static_shared_bytes=0,constant_bytes=0;
+    double theoretical_occupancy=0.;
+};
+// CPU-safe abstraction. Concrete CUDA buffers, events and device ownership stay in .cu.
+class ImagePlaneGpuContext {
+public:
+    ImagePlaneGpuStatistics statistics;
+    virtual ~ImagePlaneGpuContext() = default;
+    virtual void evaluate(const image_plane::Input*,std::size_t,const image_plane::Tables&,
+                          image_plane::Output*,bool timing=false)=0;
+    virtual ImagePlaneGpuResources resources()=0;
+    virtual ImagePlaneLayout device_layout()=0;
+    virtual void close()=0;
+};
+std::unique_ptr<ImagePlaneGpuContext> make_image_plane_gpu_context(int device);
+}
