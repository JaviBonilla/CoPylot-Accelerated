+#ifndef SOLARPILOT_FLUX_DENSITY_NUMERICS_H
+#define SOLARPILOT_FLUX_DENSITY_NUMERICS_H
+
+#include <cmath>
+#include <type_traits>
+
+// CPU-only numerical core. Packing, visibility apertures and ownership stay in the adapter.
+namespace flux_density {
+struct HeliostatData {
+    double direction[3];
+    double aim[3];
+    double sigma_x, sigma_y, normalization;
+    double coefficients[16];
+};
+struct CellData { double position[3]; double normal[3]; };
+struct Parameters { double tower_height, pi; };
+static_assert(std::is_trivial<HeliostatData>::value, "Heliostat data must be trivial");
+static_assert(std::is_standard_layout<CellData>::value, "Cell data must have standard layout");
+
+inline double visibility_cosine(const HeliostatData& h, const CellData& c) {
+    return c.normal[0]*h.direction[0] + c.normal[1]*h.direction[1] + c.normal[2]*h.direction[2];
+}
+
+inline double hermite_series(const double (&coefficients)[16], double x, double y) {
+    double hx[9], hy[9];
+    hx[0] = hy[0] = 1.;
+    hx[1] = hy[1] = 0.;
+    double factor = -2.;
+    for (int i = 1; i < 8; ++i) {
+        ++factor;
+        hx[i+1] = x*hx[i] - factor*hx[i-1];
+        hy[i+1] = y*hy[i] - factor*hy[i-1];
+    }
+    int packed = 0;
+    double flux = 0.;
+    for (int i = 1; i < 8; ++i) {
+        for (int j = (i-1)%2+1; j <= 8-i; j += 2) {
+            flux += coefficients[packed]*hx[i+1]*hy[j+1];
+            ++packed;
+        }
+    }
+    if (flux < 0.) flux = 0.;
+    return flux;
+}
+
+inline double evaluate_contribution(const HeliostatData& h, const CellData& c, const Parameters& p) {
+    const double cosine = visibility_cosine(h, c);
+    if (cosine < 0. || cosine > 1.) return 0.;
+    // Preserve plane_intersect's sequential dot sums for valid nonzero directions.
+    // A zero direction is invalid geometry (the oracle leaves its point uninitialized).
+    double denominator = 0., numerator = 0.;
+    for (int i = 0; i < 3; ++i) denominator += h.direction[i]*h.direction[i];
+    for (int i = 0; i < 3; ++i) numerator += (h.aim[i]-c.position[i])*h.direction[i];
+    double projected[3] = {0., 0., 0.};
+    if (denominator != 0.) {
+        const double distance = numerator / denominator;
+        for (int i = 0; i < 3; ++i) projected[i] = c.position[i] + distance*h.direction[i];
+    }
+    for (int i = 0; i < 3; ++i) projected[i] -= h.aim[i];
+    const double azimuth = std::atan2(h.direction[0], h.direction[1]);
+    const double zenith = std::acos(h.direction[2]);
+    double ct = std::cos(p.pi-azimuth), st = std::sin(p.pi-azimuth);
+    const double x = ct*projected[0] + st*projected[1] + 0.*projected[2];
+    const double y = -st*projected[0] + ct*projected[1] + 0.*projected[2];
+    const double z = 0.*projected[0] + 0.*projected[1] + 1.*projected[2];
+    ct = std::cos(zenith); st = std::sin(zenith);
+    const double rotated_x = 1.*x + 0.*y + 0.*z;
+    const double rotated_y = 0.*x + ct*y + st*z;
+    const double xn = -rotated_x / p.tower_height / h.sigma_x;
+    const double yn = rotated_y / p.tower_height / h.sigma_y;
+    const double hfe = hermite_series(h.coefficients, xn, yn) * std::exp(-0.5*(xn*xn + yn*yn));
+    return cosine * hfe * h.normalization;
+}
+}
+#endif
