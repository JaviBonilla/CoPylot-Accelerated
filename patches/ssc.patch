+        if (rel>max_rel) { max_rel=rel;rel_h=h;rel_index=index; }
+        squares+=static_cast<long double>(d)*d;
+        passed=passed && d<=1.e-10+1.e-9*std::abs(expected);
+    }
+    void json(std::ostream& out) const {
+        out<<std::setprecision(17)<<"{\"count\":"<<count<<",\"max_abs\":"<<max_abs<<",\"max_rel\":";
+        if (std::isfinite(max_rel)) out<<max_rel;else out<<"null";
+        out<<",\"rms\":"<<(count?double(std::sqrt(squares/count)):0.)
+           <<",\"worst_h_abs\":"<<abs_h<<",\"worst_index_abs\":"<<abs_index
+           <<",\"worst_h_rel\":"<<rel_h<<",\"worst_index_rel\":"<<rel_index
+           <<",\"zero_reference_nonzero\":"<<zero_reference_nonzero<<",\"nonfinite\":"<<nonfinite
+           <<",\"bitwise\":"<<(bitwise?"true":"false")<<",\"passed\":"<<(passed?"true":"false")<<'}';
+    }
+};
+struct Comparison {
+    Differences families[output_families],global;
+    void add(const Output& expected,const Output& actual,std::size_t h) {
+        if (expected.updated!=actual.updated) throw std::runtime_error("CPU/CUDA image-plane updated flag mismatch");
+        double e[output_values],a[output_values];pack_output(expected,e);pack_output(actual,a);
+        const int bounds[]={0,49,98,147,196,212,214,215};
+        for (int f=0;f<output_families;++f) for (int i=bounds[f];i<bounds[f+1];++i) {
+            families[f].add(e[i],a[i],h,i-bounds[f]);global.add(e[i],a[i],h,i);
+        }
+    }
+    void json(std::ostream& out) const {
+        const char* names[]={"sun","errors","mirror","flux_moments","coefficients","sigmas","intercept"};
+        out<<"{\"families\":{";
+        for (int i=0;i<output_families;++i) { if (i) out<<',';out<<'"'<<names[i]<<"\":";families[i].json(out); }
+        out<<"},\"global\":";global.json(out);out<<'}';
+    }
+};
+}
+#endif
