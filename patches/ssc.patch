+/* SPDX-License-Identifier: BSD-3-Clause */
+#include "Flux.h"
+#include "ComputeBackend.h"
+#include "ImagePlaneInterceptComparison.h"
+#include "Heliostat.h"
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iomanip>
+#include <stdexcept>
+
+void Flux::imagePlaneInterceptCudaBatch(var_map& variables,Hvector& heliostats,Vect* sun,bool timing) {
+    using Clock=std::chrono::steady_clock;
+    _image_plane_batch_ready=false;
+    if (!_image_gpu_context || !_image_gpu_context->image_plane)
+        throw std::runtime_error("CUDA image-plane executor is not initialized");
+    const char* timing_file=std::getenv("SOLARPILOT_IMAGE_TIMING_FILE");
+    timing=timing || (timing_file && *timing_file);
+    bool verify=false;
+    const char* comparison_file=nullptr;
+#ifdef SOLARPILOT_ENABLE_FLUX_DIAGNOSTICS
+    const char* mode=std::getenv("SOLARPILOT_INTERCEPT_PATH");
+    comparison_file=std::getenv("SOLARPILOT_IMAGE_COMPARE_FILE");
+    verify=(mode && std::strcmp(mode,"verify_cuda")==0) || (comparison_file && *comparison_file);
+#endif
+    if (verify && timing) throw std::runtime_error("Image-plane timing requires verification disabled");
+    const auto begin=timing?Clock::now():Clock::time_point();
+    _image_inputs.resize(heliostats.size());_image_outputs.resize(heliostats.size());
+    for (std::size_t h=0;h<heliostats.size();++h) {
+        _image_inputs[h]={};
+        if (!prepareImagePlane(variables,*heliostats[h],heliostats[h]->getWhichReceiver(),sun,_image_inputs[h]))
+            throw std::runtime_error("CUDA image-plane input outside the validated single-cylinder/simple-aim/specified-sun/on-axis/64-facet scope at heliostat index "+std::to_string(h));
+    }
+    const double preparation=timing?std::chrono::duration<double>(Clock::now()-begin).count():0.;
+    auto& executor=*_image_gpu_context->image_plane;
+    executor.evaluate(_image_inputs.data(),_image_inputs.size(),_image_tables,_image_outputs.data(),timing);
+    image_plane::Comparison comparison;
+    if (verify) {
+        for (std::size_t h=0;h<heliostats.size();++h) {
+            image_plane::Output expected;
+            image_plane::evaluate(_image_inputs[h],_image_tables,expected);
+            comparison.add(expected,_image_outputs[h],h);
+        }
+        if (comparison_file && *comparison_file) {
+            std::ofstream out(comparison_file,std::ios::app);
+            if (!out) throw std::runtime_error("Cannot write CUDA image-plane comparison");
+            out<<"{\"heliostats\":"<<heliostats.size()<<",\"block_size\":128,\"allocations\":"<<executor.statistics.allocations
+               <<",\"input_capacity\":"<<executor.statistics.input_capacity<<",\"output_capacity\":"<<executor.statistics.output_capacity
+               <<",\"errors\":";comparison.json(out);out<<"}\n";
+            if (!out) throw std::runtime_error("Cannot finish CUDA image-plane comparison");
+        }
+        if (!comparison.global.passed) throw std::runtime_error("CUDA image-plane optical output differs beyond rtol=1e-9, atol=1e-10; inspect family diagnostics");
+    }
+    const auto write_begin=timing?Clock::now():Clock::time_point();
+    // Validate the complete downloaded state before changing any heliostat.
+    for (const auto& result:_image_outputs) {
+        double values[image_plane::output_values];image_plane::pack_output(result,values);
+        for (double value:values) if (!std::isfinite(value)) throw std::runtime_error("CUDA image-plane produced nonfinite optical state");
+        if (result.updated>1) throw std::runtime_error("CUDA image-plane produced an invalid update flag");
+    }
+    for (std::size_t h=0;h<heliostats.size();++h) {
+        writeImagePlane(*heliostats[h],_image_outputs[h]);
+        // Preserve the raw return value; the existing efficiency caller performs its clamp.
+        heliostats[h]->setEfficiencyIntercept(_image_outputs[h].intercept);
+    }
+    _image_plane_batch_ready=true;
+    executor.statistics.preparation_s=preparation;
+    if (timing) {
+        auto& stats=executor.statistics;
+        stats.writeback_s=std::chrono::duration<double>(Clock::now()-write_begin).count();
+        stats.total_s=std::chrono::duration<double>(Clock::now()-begin).count();
+        if (timing_file && *timing_file) {
+            std::ofstream out(timing_file,std::ios::app);
+            if (!out) throw std::runtime_error("Cannot write CUDA image-plane timing");
+            out<<std::setprecision(17)<<stats.heliostats<<','<<stats.preparation_s<<','<<stats.input_h2d_ms<<','<<stats.tables_h2d_ms
+               <<','<<stats.kernel_ms<<','<<stats.d2h_ms<<','<<stats.writeback_s<<','<<stats.total_s<<'\n';
+            if (!out) throw std::runtime_error("Cannot finish CUDA image-plane timing");
+        }
+    }
+}
