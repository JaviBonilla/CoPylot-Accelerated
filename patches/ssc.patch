+        Heliostat* source = helios.at(i);
+        if (!source->IsEnabled()) continue;
+        flux_density::HeliostatData h;
+        source->getImageSize(h.sigma_x, h.sigma_y);
+        const sp_point& aim = *source->getAimPoint();
+        sp_point* location = source->getLocation();
+        Vect direction(location->x-receiver_offset.x, location->y-receiver_offset.y, location->z-receiver_offset.z-tht);
+        Toolbox::unitvect(direction);
+        h.direction[0] = direction.i; h.direction[1] = direction.j; h.direction[2] = direction.k;
+        h.aim[0] = aim.x; h.aim[1] = aim.y; h.aim[2] = aim.z;
