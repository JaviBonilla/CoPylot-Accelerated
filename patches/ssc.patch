diff --git a/solarpilot/ImagePlaneInterceptKernels.cu b/solarpilot/ImagePlaneInterceptKernels.cu
new file mode 100644
index 000000000..3a9162505
--- /dev/null
+++ b/solarpilot/ImagePlaneInterceptKernels.cu
@@ -0,0 +1,191 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+#include "ImagePlaneInterceptCuda.h"
+#include "ImagePlaneInterceptNumerics.h"
+#include "ComputeBackend.h"
+#include <cuda_runtime.h>
+#include <climits>
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+#include <string>
+
+namespace solarpilot {
+namespace {
+void check(cudaError_t status,const char* operation) {
+    if (status!=cudaSuccess) throw std::runtime_error(std::string(operation)+": "+cudaGetErrorString(status));
+}
+class DeviceGuard {
+    int previous_=0;
+    bool changed_=false;
+public:
+    explicit DeviceGuard(int device) {
+        check(cudaGetDevice(&previous_),"cudaGetDevice(image-plane)");
+        if (previous_!=device) { check(cudaSetDevice(device),"cudaSetDevice(image-plane)"); changed_=true; }
+    }
+    void restore() {
+        if (changed_) { check(cudaSetDevice(previous_),"cudaSetDevice(image-plane restore)"); changed_=false; }
+    }
+    ~DeviceGuard() { if (changed_) cudaSetDevice(previous_); }
+};
+template<class T> class Buffer {
+    int device_;
+    T* pointer_=nullptr;
+    std::size_t capacity_=0;
+public:
+    explicit Buffer(int device):device_(device) {}
+    Buffer(const Buffer&)=delete;
+    Buffer& operator=(const Buffer&)=delete;
+    ~Buffer() { try { DeviceGuard guard(device_); release(); } catch (...) {} }
+    T* data() const { return pointer_; }
+    std::size_t capacity() const { return capacity_; }
+    bool reserve(std::size_t count) {
+        if (count<=capacity_) return false;
+        if (count>std::numeric_limits<std::size_t>::max()/sizeof(T)) throw std::runtime_error("Image-plane buffer size overflow");
+        T* replacement=nullptr;
+        check(cudaMalloc(reinterpret_cast<void**>(&replacement),count*sizeof(T)),"cudaMalloc(image-plane)");
+        try { release(); } catch (const std::exception& error) {
+            const cudaError_t cleanup=cudaFree(replacement);
+            if (cleanup!=cudaSuccess) throw std::runtime_error(std::string(error.what())+"; replacement cleanup: "+cudaGetErrorString(cleanup));
+            throw;
+        }
+        pointer_=replacement;capacity_=count;return true;
+    }
+    void release() {
+        if (pointer_) { check(cudaFree(pointer_),"cudaFree(image-plane)");pointer_=nullptr;capacity_=0; }
+    }
+};
+class Event {
+    int device_;
+    cudaEvent_t event_=nullptr;
+public:
+    explicit Event(int device):device_(device) {}
+    Event(const Event&)=delete;
+    Event& operator=(const Event&)=delete;
+    ~Event() { try { DeviceGuard guard(device_);release(); } catch (...) {} }
+    void record() {
+        if (!event_) check(cudaEventCreate(&event_),"cudaEventCreate(image-plane)");
+        check(cudaEventRecord(event_,0),"cudaEventRecord(image-plane)");
+    }
+    double elapsed_from(const Event& start) {
+        check(cudaEventSynchronize(event_),"cudaEventSynchronize(image-plane)");
+        float milliseconds=0.; // CUDA event API type; all optical arithmetic is double.
+        check(cudaEventElapsedTime(&milliseconds,start.event_,event_),"cudaEventElapsedTime(image-plane)");
+        return milliseconds;
+    }
+    void release() { if (event_) { check(cudaEventDestroy(event_),"cudaEventDestroy(image-plane)");event_=nullptr; } }
+};
+
+__global__ void image_plane_kernel(const image_plane::Input* inputs,std::size_t count,
+                                   const image_plane::Tables* tables,image_plane::Output* outputs) {
+    const std::size_t h=std::size_t(blockIdx.x)*blockDim.x+threadIdx.x;
+    if (h<count) image_plane::detail::evaluate(inputs[h],*tables,outputs[h]);
+}
+__global__ void image_plane_layout_kernel(std::uint64_t* result) {
+    const std::uint64_t layout[]={sizeof(image_plane::Input),alignof(image_plane::Input),sizeof(image_plane::Output),alignof(image_plane::Output),
+        sizeof(image_plane::Tables),alignof(image_plane::Tables),offsetof(image_plane::Input,mirror_normalized),
+        offsetof(image_plane::Input,panel_x),offsetof(image_plane::Input,cant_method),offsetof(image_plane::Input,visible),
+        offsetof(image_plane::Output,hermite),offsetof(image_plane::Output,sigma),offsetof(image_plane::Output,intercept),
+        offsetof(image_plane::Output,updated),sizeof(std::int32_t),sizeof(std::uint8_t)};
+    for (int i=0;i<int(image_plane_layout_fields);++i) result[i]=layout[i];
+}
+void validate(const image_plane::Input& in) {
+    if (in.visible>1 || in.faceted>1) throw std::runtime_error("Invalid image-plane visibility/facet flag");
+    if (!in.visible) return;
+    if ((in.cant_method!=0 && in.cant_method!=-1 && in.cant_method!=1)
+        || (in.faceted && (in.facets_x<=0 || in.facets_y<=0 || in.facets_x>image_plane::max_facets
+            || in.facets_y>image_plane::max_facets || in.facets_x*in.facets_y>image_plane::max_facets)))
+        throw std::runtime_error("CUDA image-plane supports no-cant/on-axis canting and at most 64 valid facets");
+    const double scalars[]={in.tower_height,in.radial_position,in.optical_height,in.diameter,in.receiver_height,
+        in.focal_x,in.focal_y,in.slant_range,in.aim_x,in.aim_y,
+        in.tracking.i,in.tracking.j,in.tracking.k,in.tower.i,in.tower.j,in.tower.k,in.sun.i,in.sun.j,in.sun.k};
+    for (double v:scalars) if (!std::isfinite(v)) throw std::runtime_error("Nonfinite CUDA image-plane input");
+    if (in.tower_height<=0. || in.optical_height<=0. || in.diameter<=0. || in.receiver_height<=0.
+        || in.focal_x==0. || in.focal_y==0. || in.slant_range<=0.
+        || (in.faceted && in.cant_method==1 && (!std::isfinite(in.cant_radius) || in.cant_radius<=0.)))
+        throw std::runtime_error("Invalid CUDA image-plane height, focus, slant or cant radius");
+    for (int k=0;k<2;++k) if (!std::isfinite(in.angular[k]) || !std::isfinite(in.surface[k]) || !std::isfinite(in.reflected[k]))
+        throw std::runtime_error("Nonfinite CUDA image-plane optical errors");
+    for (double v:in.mirror_normalized.values) if (!std::isfinite(v)) throw std::runtime_error("Nonfinite CUDA normalized mirror moments");
+    if (in.faceted) for (int i=0;i<in.facets_x*in.facets_y;++i)
+        if (!std::isfinite(in.panel_x[i]) || !std::isfinite(in.panel_y[i])) throw std::runtime_error("Nonfinite CUDA facet center");
+}
+class ImagePlaneContext final:public ImagePlaneGpuContext {
+    int device_;
+    Buffer<image_plane::Input> inputs_;
+    Buffer<image_plane::Output> outputs_;
+    Buffer<image_plane::Tables> tables_;
+    Event start_,end_;
+    std::size_t allocations_=0;
+    void snapshot(std::size_t count,bool timed) {
+        statistics=ImagePlaneGpuStatistics();
+        statistics.heliostats=count;statistics.timed=timed;statistics.allocations=allocations_;
+        statistics.input_capacity=inputs_.capacity();statistics.output_capacity=outputs_.capacity();statistics.table_capacity=tables_.capacity();
+    }
+public:
+    explicit ImagePlaneContext(int device):device_(device),inputs_(device),outputs_(device),tables_(device),start_(device),end_(device) {
+        const int count=cuda_device_count();
+        if (count<0) throw std::runtime_error(cuda_probe_error());
+        if (device<0 || device>=count) throw std::runtime_error("CUDA image-plane device index out of range");
+    }
+    ~ImagePlaneContext() override { try { close(); } catch (...) {} }
+    void evaluate(const image_plane::Input* input,std::size_t count,const image_plane::Tables& tables,
+                  image_plane::Output* output,bool timing) override {
+        if (count>std::size_t(INT_MAX) || (count && (!input || !output))) throw std::runtime_error("Invalid CUDA image-plane array dimensions");
+        for (std::size_t h=0;h<count;++h) validate(input[h]);
+        DeviceGuard guard(device_);
+        if (!count) { snapshot(0,timing);guard.restore();return; }
+        allocations_+=inputs_.reserve(count);allocations_+=outputs_.reserve(count);allocations_+=tables_.reserve(1);
+        snapshot(count,timing);
+        statistics.input_h2d_bytes=sizeof(image_plane::Input)*count;
+        statistics.tables_h2d_bytes=sizeof(tables);
+        statistics.output_d2h_bytes=sizeof(image_plane::Output)*count;
+        if (timing) start_.record();
+        check(cudaMemcpy(inputs_.data(),input,statistics.input_h2d_bytes,cudaMemcpyHostToDevice),"cudaMemcpy(image-plane inputs H2D)");
+        if (timing) { end_.record();statistics.input_h2d_ms=end_.elapsed_from(start_);start_.record(); }
+        check(cudaMemcpy(tables_.data(),&tables,sizeof(tables),cudaMemcpyHostToDevice),"cudaMemcpy(image-plane tables H2D)");
+        if (timing) { end_.record();statistics.tables_h2d_ms=end_.elapsed_from(start_);start_.record(); }
+        image_plane_kernel<<<static_cast<unsigned>((count+image_plane_block_size-1)/image_plane_block_size),image_plane_block_size>>>(inputs_.data(),count,tables_.data(),outputs_.data());
+        check(cudaGetLastError(),"image-plane kernel launch");
+        if (timing) { end_.record();statistics.kernel_ms=end_.elapsed_from(start_);start_.record(); }
+        // Blocking default-stream D2H also reports asynchronous execution errors.
+        check(cudaMemcpy(output,outputs_.data(),statistics.output_d2h_bytes,cudaMemcpyDeviceToHost),"cudaMemcpy(image-plane outputs D2H)");
+        if (timing) { end_.record();statistics.d2h_ms=end_.elapsed_from(start_); }
+        guard.restore();
+    }
+    ImagePlaneGpuResources resources() override {
+        DeviceGuard guard(device_);
+        cudaFuncAttributes attributes;cudaDeviceProp properties;
+        check(cudaFuncGetAttributes(&attributes,image_plane_kernel),"cudaFuncGetAttributes(image-plane)");
+        check(cudaGetDeviceProperties(&properties,device_),"cudaGetDeviceProperties(image-plane)");
+        ImagePlaneGpuResources out;
+        out.registers=attributes.numRegs;out.local_bytes=attributes.localSizeBytes;out.static_shared_bytes=attributes.sharedSizeBytes;
+        out.constant_bytes=attributes.constSizeBytes;out.max_threads=attributes.maxThreadsPerBlock;
+        out.sm_count=properties.multiProcessorCount;out.warp_size=properties.warpSize;out.max_threads_per_sm=properties.maxThreadsPerMultiProcessor;
+        out.compute_major=properties.major;out.compute_minor=properties.minor;
+        check(cudaRuntimeGetVersion(&out.runtime_version),"cudaRuntimeGetVersion(image-plane)");
+        check(cudaDriverGetVersion(&out.driver_version),"cudaDriverGetVersion(image-plane)");
+        check(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&out.active_blocks_per_sm,image_plane_kernel,image_plane_block_size,0),"cudaOccupancyMaxActiveBlocksPerMultiprocessor(image-plane)");
+        out.theoretical_occupancy=double(out.active_blocks_per_sm*image_plane_block_size)/out.max_threads_per_sm;
+        guard.restore();return out;
+    }
+    ImagePlaneLayout device_layout() override {
+        DeviceGuard guard(device_);
+        Buffer<std::uint64_t> data(device_);data.reserve(image_plane_layout_fields);
+        image_plane_layout_kernel<<<1,1>>>(data.data());
+        check(cudaGetLastError(),"image-plane layout kernel launch");
+        ImagePlaneLayout result;
+        check(cudaMemcpy(result.data(),data.data(),sizeof(result),cudaMemcpyDeviceToHost),"cudaMemcpy(image-plane layout D2H)");
+        data.release();guard.restore();return result;
+    }
+    void close() override {
+        DeviceGuard guard(device_);std::string error;
+        auto release=[&](auto& r) { try { r.release(); } catch (const std::exception& e) { if (error.empty()) error=e.what(); } };
+        release(inputs_);release(outputs_);release(tables_);release(start_);release(end_);
+        guard.restore();if (!error.empty()) throw std::runtime_error(error);
+    }
+};
+}
+std::unique_ptr<ImagePlaneGpuContext> make_image_plane_gpu_context(int device) {
+    return std::unique_ptr<ImagePlaneGpuContext>(new ImagePlaneContext(device));
+}
+}
