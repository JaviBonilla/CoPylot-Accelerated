+SPEXPORT bool sp_restore_loaded_layout(sp_data_t p_data) {
+    if (!p_data) return false;
+    auto& mc=*static_cast<CopilotObject*>(p_data);
+    mc.compute.error.clear();
+    if (!mc.spt_layout_pending) {
+        mc.compute.error="Serialized restoration requires a newly loaded SPT project.";
+        return false;
+    }
+    try {
+        validate_serialized_layout(mc.variables);
+        mc.solarfield.Create(mc.variables);
+        SolarField::PrepareFieldLayout(mc.solarfield,nullptr,true,true);
+        if (mc.solarfield.ErrCheck() || mc.solarfield.CheckCancelStatus()
+            || mc.solarfield.getHeliostats()->size()!=mc.solarfield.getLayoutShellObject()->size())
+            throw std::runtime_error("Serialized layout geometry preparation failed.");
+        mc.solarfield.calcHeliostatArea();
+        mc.solarfield.updateAllCalculatedParameters(mc.variables);
+        mc.results.clear();
+        mc.spt_layout_pending=false;
+        return true;
+    } catch (const std::exception& e) {
+        mc.compute.error=std::string("Unable to restore serialized layout: ")+e.what();
+    } catch (...) { mc.compute.error="Unable to restore serialized layout: unknown error."; }
+    mc.solarfield.Clean();
+    mc.results.clear();
+    return false;
+}
