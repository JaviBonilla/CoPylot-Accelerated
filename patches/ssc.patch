+{
+    if (!p_data) return false;
+    auto& state = static_cast<CopilotObject*>(p_data)->compute;
+    state.error.clear();
+    if (backend == static_cast<int>(solarpilot::ComputeBackend::CPU)) {
+        state.selected = solarpilot::ComputeBackend::CPU;
+        return true;
