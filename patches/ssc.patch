+class DeviceGuard {
+    int previous_ = 0;
+    bool changed_ = false;
+public:
+    explicit DeviceGuard(int device) {
+        check(cudaGetDevice(&previous_), "cudaGetDevice(flux)");
+        if (device != previous_) {
+            check(cudaSetDevice(device), "cudaSetDevice(flux)");
+            changed_ = true;
+        }
+    }
+    void restore() {
+        if (changed_) { check(cudaSetDevice(previous_), "cudaSetDevice(flux restore)"); changed_ = false; }
+    }
+    ~DeviceGuard() { if (changed_) cudaSetDevice(previous_); }
+};
+// Every allocation retains its device, including exceptional destructor cleanup.
+template<class T> class Buffer {
+    int device_;
+    T* data_ = nullptr;
+    std::size_t capacity_ = 0;
+public:
+    explicit Buffer(int device) : device_(device) {}
+    Buffer(const Buffer&) = delete;
+    Buffer& operator=(const Buffer&) = delete;
+    ~Buffer() { try { DeviceGuard guard(device_); release(); } catch (...) {} }
+    T* data() const { return data_; }
+    std::size_t capacity() const { return capacity_; }
+    bool reserve(std::size_t count) {
+        if (count <= capacity_) return false;
+        if (count > std::numeric_limits<std::size_t>::max()/sizeof(T))
+            throw std::runtime_error("CUDA flux buffer size overflow");
+        T* replacement = nullptr;
+        check(cudaMalloc(reinterpret_cast<void**>(&replacement), count*sizeof(T)), "cudaMalloc(flux)");
+        // Replacement is guarded even if freeing the old allocation fails.
+        try { release(); } catch (const std::exception& error) {
+            const cudaError_t cleanup = cudaFree(replacement);
+            if (cleanup != cudaSuccess) throw std::runtime_error(std::string(error.what())+"; replacement cleanup: "+cudaGetErrorString(cleanup));
+            throw;
+        }
+        data_ = replacement; capacity_ = count;
+        return true;
+    }
+    void release() {
+        if (data_) { check(cudaFree(data_), "cudaFree(flux)"); data_ = nullptr; capacity_ = 0; }
+    }
+};
+class Event {
+    int device_;
+    cudaEvent_t event_ = nullptr;
+public:
+    explicit Event(int device) : device_(device) {}
+    Event(const Event&) = delete;
+    Event& operator=(const Event&) = delete;
+    ~Event() { try { DeviceGuard guard(device_); release(); } catch (...) {} }
+    void ensure() { if (!event_) check(cudaEventCreate(&event_), "cudaEventCreate(flux)"); }
+    void record() { ensure(); check(cudaEventRecord(event_, 0), "cudaEventRecord(flux)"); }
+    double elapsed_from(const Event& start) {
+        check(cudaEventSynchronize(event_), "cudaEventSynchronize(flux)");
+        float milliseconds = 0.; // CUDA event API uses float; optical arithmetic remains double.
+        check(cudaEventElapsedTime(&milliseconds, start.event_, event_), "cudaEventElapsedTime(flux)");
+        return milliseconds;
+    }
+    void release() {
+        if (event_) { check(cudaEventDestroy(event_), "cudaEventDestroy(flux)"); event_ = nullptr; }
+    }
+};
+
+// SoA[field][h], stride = current active H, independent of allocated capacity.
+__device__ flux_density::HeliostatData load_heliostat(const double* data, std::size_t stride, std::size_t h) {
+    flux_density::HeliostatData value;
+    for (int k = 0; k < 3; ++k) { value.direction[k] = data[k*stride+h]; value.aim[k] = data[(k+3)*stride+h]; }
+    value.sigma_x = data[6*stride+h]; value.sigma_y = data[7*stride+h]; value.normalization = data[8*stride+h];
+    for (int k = 0; k < 16; ++k) value.coefficients[k] = data[(9+k)*stride+h];
+    return value;
+}
+__global__ void flux_density_kernel(const double* heliostats, std::size_t count,
+                                    const flux_density::CellData* cells,
+                                    flux_density::Parameters parameters, double* output) {
+    const std::size_t cell = blockIdx.x;
+    const flux_density::CellData point = cells[cell];
+    double partial = 0.;
+    for (std::size_t h = threadIdx.x; h < count; h += blockDim.x)
+        partial += flux_density::evaluate_contribution(load_heliostat(heliostats, count, h), point, parameters);
+    extern __shared__ double sums[];
+    sums[threadIdx.x] = partial;
+    __syncthreads();
+    // Fixed power-of-two tree. All lanes participate, including H < blockDim.
+    for (unsigned offset = blockDim.x/2; offset > 0; offset /= 2) {
+        if (threadIdx.x < offset) sums[threadIdx.x] += sums[threadIdx.x+offset];
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) output[cell] = sums[0];
+}
+__global__ void contribution_kernel(const double* heliostats, const flux_density::CellData* cells,
+                                    std::size_t count, flux_density::Parameters parameters, double* output) {
+    const std::size_t pair = std::size_t(blockIdx.x)*blockDim.x+threadIdx.x;
+    if (pair < count) output[pair] = flux_density::evaluate_contribution(load_heliostat(heliostats, count, pair), cells[pair], parameters);
+}
+
+class FluxGpuContext final : public GpuContext {
+    int device_;
+    Buffer<double> heliostats_, output_;
+    Buffer<flux_density::CellData> cells_;
+    Event start_, end_;
+    std::vector<double> packed_;
+    std::size_t allocations_ = 0;
+    void prepare(const flux_density::HeliostatData* h, std::size_t count,
+                 const flux_density::CellData* cells, std::size_t cell_count, bool timing) {
+        if ((count && !h) || !cells || !cell_count) throw std::runtime_error("Invalid CUDA flux input arrays");
+        if (count > std::numeric_limits<std::size_t>::max()/25) throw std::runtime_error("CUDA heliostat size overflow");
+        const auto begin = std::chrono::steady_clock::now();
+        packed_.resize(25*count);
+        for (std::size_t i = 0; i < count; ++i) {
+            for (int k = 0; k < 3; ++k) { packed_[k*count+i] = h[i].direction[k]; packed_[(k+3)*count+i] = h[i].aim[k]; }
+            packed_[6*count+i] = h[i].sigma_x; packed_[7*count+i] = h[i].sigma_y; packed_[8*count+i] = h[i].normalization;
+            for (int k = 0; k < 16; ++k) packed_[(9+k)*count+i] = h[i].coefficients[k];
+        }
+        statistics = FluxGpuStatistics();
+        statistics.timed = timing;
+        if (timing) statistics.soa_preparation_s = std::chrono::duration<double>(std::chrono::steady_clock::now()-begin).count();
+        allocations_ += heliostats_.reserve(25*count);
+        allocations_ += cells_.reserve(cell_count);
+        allocations_ += output_.reserve(cell_count);
+        statistics.heliostats = count; statistics.cells = cell_count;
+        statistics.heliostat_capacity = heliostats_.capacity()/25;
+        statistics.cell_capacity = cells_.capacity(); statistics.output_capacity = output_.capacity();
+        statistics.allocations = allocations_;
+        if (timing) start_.record();
+        if (count) check(cudaMemcpy(heliostats_.data(), packed_.data(), 200*count, cudaMemcpyHostToDevice), "cudaMemcpy(flux heliostats H2D)");
+        if (timing) { end_.record(); statistics.h2d_heliostat_ms = end_.elapsed_from(start_); start_.record(); }
+        check(cudaMemcpy(cells_.data(), cells, sizeof(flux_density::CellData)*cell_count, cudaMemcpyHostToDevice), "cudaMemcpy(flux cells H2D)");
+        if (timing) { end_.record(); statistics.h2d_cell_ms = end_.elapsed_from(start_); }
+    }
+    void download(double* output, std::size_t count, bool timing) {
+        check(cudaGetLastError(), "flux kernel launch");
+        if (timing) { end_.record(); statistics.kernel_ms = end_.elapsed_from(start_); }
+        else check(cudaDeviceSynchronize(), "flux kernel execution");
+        if (timing) start_.record();
+        check(cudaMemcpy(output, output_.data(), sizeof(double)*count, cudaMemcpyDeviceToHost), "cudaMemcpy(flux D2H)");
+        if (timing) { end_.record(); statistics.d2h_ms = end_.elapsed_from(start_); }
+    }
+public:
+    explicit FluxGpuContext(int device) : device_(device), heliostats_(device), output_(device), cells_(device), start_(device), end_(device) {
+        const int count = cuda_device_count();
+        if (count < 0) throw std::runtime_error(cuda_probe_error());
+        if (device < 0 || device >= count) throw std::runtime_error("CUDA device index out of range");
+    }
+    ~FluxGpuContext() override { try { close(); } catch (...) {} }
+    void evaluate_flux(const flux_density::HeliostatData* h, std::size_t count,
+                       const flux_density::CellData* cells, std::size_t cell_count,
+                       const flux_density::Parameters& parameters, double* output, int block, bool timing) override {
+        if (block != 64 && block != 128 && block != 256 && block != 512)
+            throw std::runtime_error("CUDA flux block size must be 64, 128, 256 or 512");
+        if (!output || cell_count > unsigned(std::numeric_limits<int>::max())) throw std::runtime_error("Invalid CUDA flux output dimensions");
+        DeviceGuard device(device_);
+        prepare(h, count, cells, cell_count, timing);
+        if (timing) start_.record();
+        flux_density_kernel<<<static_cast<unsigned>(cell_count), block, block*sizeof(double)>>>(heliostats_.data(), count, cells_.data(), parameters, output_.data());
+        download(output, cell_count, timing);
+        device.restore();
+    }
+    void evaluate_pairs(const flux_density::HeliostatData* h, const flux_density::CellData* cells,
+                        std::size_t count, const flux_density::Parameters& parameters, double* output) override {
+        if (!output || count > std::size_t(std::numeric_limits<int>::max())) throw std::runtime_error("Invalid CUDA contribution dimensions");
+        DeviceGuard device(device_);
+        prepare(h, count, cells, count, false);
+        contribution_kernel<<<static_cast<unsigned>((count+255)/256), 256>>>(heliostats_.data(), cells_.data(), count, parameters, output_.data());
+        download(output, count, false);
+        device.restore();
+    }
+    void close() override {
+        DeviceGuard device(device_);
+        // Attempt all releases; report the first failure on normal teardown.
+        std::string error;
+        auto release = [&](auto& resource) { try { resource.release(); } catch (const std::exception& e) { if (error.empty()) error = e.what(); } };
+        release(heliostats_); release(cells_); release(output_); release(start_); release(end_);
+        device.restore();
+        if (!error.empty()) throw std::runtime_error(error);
+    }
+};
+}
+std::unique_ptr<GpuContext> make_gpu_context(int device) {
+    return std::unique_ptr<GpuContext>(new FluxGpuContext(device));
+}
+}
