diff --git a/solarpilot/CudaProbe.cu b/solarpilot/CudaProbe.cu
new file mode 100644
index 000000000..cd8f06b83
--- /dev/null
+++ b/solarpilot/CudaProbe.cu
@@ -0,0 +1,81 @@
+// Toolchain/device verification only; no optical algorithm is implemented here.
+#include "ComputeBackend.h"
+#include <cuda_runtime.h>
+
+namespace solarpilot {
+namespace {
+thread_local std::string probe_error;
+__global__ void probe_kernel(int* result) { *result = 42; }
+
+bool checked(cudaError_t status, const char* operation, std::string& error) {
+    if (status == cudaSuccess) return true;
+    if (!error.empty()) error += "; ";
+    error += std::string(operation) + ": " + cudaGetErrorString(status);
+    return false;
+}
+class ProbeResources {
+    int previous_;
+    bool changed_ = false;
+    int* value_ = nullptr;
+public:
+    explicit ProbeResources(int previous) : previous_(previous) {}
+    ProbeResources(const ProbeResources&) = delete;
+    ProbeResources& operator=(const ProbeResources&) = delete;
+    ~ProbeResources() {
+        // Best effort only for exceptional unwinding; normal paths call close()
+        // explicitly and return every CUDA cleanup error to the caller.
+        if (value_) cudaFree(value_);
+        if (changed_) cudaSetDevice(previous_);
+    }
+    void changed() { changed_ = true; }
+    int** address() { return &value_; }
+    int* value() const { return value_; }
+    bool close(std::string& error) {
+        bool ok = true;
+        if (value_) {
+            ok = checked(cudaFree(value_), "cudaFree(probe)", error) && ok;
+            value_ = nullptr;
+        }
+        if (changed_) {
+            ok = checked(cudaSetDevice(previous_), "cudaSetDevice(restore)", error) && ok;
+            changed_ = false;
+        }
+        return ok;
+    }
+};
+}
+
+int cuda_device_count() {
+    probe_error.clear();
+    int count = 0;
+    const cudaError_t status = cudaGetDeviceCount(&count);
+    if (status == cudaErrorNoDevice) return 0;
+    if (!checked(status, "cudaGetDeviceCount", probe_error)) return -1;
+    return count;
+}
+const char* cuda_probe_error() { return probe_error.c_str(); }
+
+bool cuda_probe_device(int device, std::string& error) {
+    error.clear();
+    const int count = cuda_device_count();
+    if (count < 0) { error = probe_error; return false; }
+    if (count == 0) { error = "No CUDA devices available"; return false; }
+    if (device < 0 || device >= count) { error = "CUDA device index out of range"; return false; }
+    int previous = 0;
+    if (!checked(cudaGetDevice(&previous), "cudaGetDevice", error)) return false;
+    ProbeResources resources(previous);
+    if (!checked(cudaSetDevice(device), "cudaSetDevice", error)) return false;
+    resources.changed();
+    auto finish = [&](bool ok) { return resources.close(error) && ok; };
+    if (!checked(cudaMalloc(reinterpret_cast<void**>(resources.address()), sizeof(int)),
+                 "cudaMalloc(probe)", error)) return finish(false);
+    probe_kernel<<<1, 1>>>(resources.value());
+    if (!checked(cudaGetLastError(), "probe kernel launch", error)) return finish(false);
+    if (!checked(cudaDeviceSynchronize(), "probe kernel execution", error)) return finish(false);
+    int value = 0;
+    if (!checked(cudaMemcpy(&value, resources.value(), sizeof(int), cudaMemcpyDeviceToHost),
+                 "cudaMemcpy(probe)", error)) return finish(false);
+    if (value != 42) { error = "CUDA probe returned an invalid result"; return finish(false); }
+    return finish(true);
+}
+}
