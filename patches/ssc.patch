+
+namespace {
+struct ErrorSummary {
+    double absolute = 0., relative = 0., squared = 0.;
+    std::size_t abs_index = 0, rel_index = 0, count = 0;
+    bool passed = true;
+    void add(double expected, double actual, std::size_t index) {
+        const double difference = std::abs(actual-expected);
+        const double rel = expected == 0. ? (difference == 0. ? 0. : std::numeric_limits<double>::infinity()) : difference/std::abs(expected);
+        if (difference > absolute) { absolute = difference; abs_index = index; }
+        if (rel > relative) { relative = rel; rel_index = index; }
+        squared += difference*difference; ++count;
+        passed = passed && std::isfinite(expected) && std::isfinite(actual)
+            && difference <= 1.e-10 + 1.e-9*std::abs(expected);
+    }
+    double rms() const { return count ? std::sqrt(squared/count) : 0.; }
+};
+}
+
+void Flux::fluxDensityCuda(simulation_info* siminfo, FluxSurface& surface, Hvector& helios, double tht, bool progress) {
+    using Clock = std::chrono::steady_clock;
+    const char* timing_path = std::getenv("SOLARPILOT_CUDA_TIMING_FILE");
+    const bool timing = timing_path && *timing_path;
+    const auto begin = timing ? Clock::now() : Clock::time_point();
+    const int nx = surface.getFluxNX(), ny = surface.getFluxNY();
+    var_receiver* variables = surface.getParent()->getVarMap();
+    if (_n_terms != 7 || variables->rec_type.mapval() != var_receiver::REC_TYPE::EXTERNAL_CYLINDRICAL
+        || nx <= 0 || ny <= 0 || !std::isfinite(tht) || tht <= 0.)
+        throw spexception("CUDA flux density requires valid cylindrical geometry and seven-term Hermite optics.");
+    FluxGrid& grid = *surface.getFluxMap();
+    const sp_point& offset = *surface.getSurfaceOffset();
+    const sp_point receiver(variables->rec_offset_x_global.Val(), variables->rec_offset_y_global.Val(), variables->rec_offset_z_global.Val());
+    const flux_density::Parameters parameters = {tht, pi};
+    std::vector<flux_density::CellData> cells;
+    std::vector<double> initial, output;
+    cells.reserve(std::size_t(nx)*ny); initial.reserve(std::size_t(nx)*ny);
+    for (int x = 0; x < nx; ++x) for (int y = 0; y < ny; ++y) {
+        const FluxPoint& point = grid.at(x).at(y);
+        const flux_density::CellData cell = {
+            {point.location.x+offset.x+receiver.x, point.location.y+offset.y+receiver.y, point.location.z+offset.z+receiver.z+tht},
+            {point.normal.i, point.normal.j, point.normal.k}};
+        for (int k = 0; k < 3; ++k) if (!std::isfinite(cell.position[k]) || !std::isfinite(cell.normal[k]))
+            throw spexception("CUDA flux density received nonfinite receiver cells.");
+        cells.push_back(cell); initial.push_back(point.flux);
+    }
+    std::vector<flux_density::HeliostatData> packed;
+    packed.reserve(helios.size());
+    for (Heliostat* source : helios) {
+        if (!source->IsEnabled()) continue;
+        matrix_t<double>* coefficients = source->getHermiteCoefObject();
+        if (coefficients->nrows()*coefficients->ncols() != 16)
+            throw spexception("CUDA flux density requires 16 prepared Hermite coefficients per enabled heliostat.");
+        flux_density::HeliostatData h;
+        source->getImageSize(h.sigma_x, h.sigma_y);
+        const sp_point& aim = *source->getAimPoint();
+        const sp_point& location = *source->getLocation();
+        Vect direction(location.x-receiver.x, location.y-receiver.y, location.z-receiver.z-tht);
+        Toolbox::unitvect(direction);
+        h.direction[0] = direction.i; h.direction[1] = direction.j; h.direction[2] = direction.k;
+        h.aim[0] = aim.x; h.aim[1] = aim.y; h.aim[2] = aim.z;
+        h.normalization = source->getArea()*source->getEfficiencyTotal()/(tht*tht);
+        for (int k = 0; k < 16; ++k) h.coefficients[k] = coefficients->at(k);
+        bool valid = std::isfinite(h.normalization) && std::isfinite(h.sigma_x) && std::isfinite(h.sigma_y)
+            && h.sigma_x > 0. && h.sigma_y > 0. && (direction.i != 0. || direction.j != 0. || direction.k != 0.);
+        for (int k = 0; k < 3; ++k) valid = valid && std::isfinite(h.direction[k]) && std::isfinite(h.aim[k]);
+        for (double coefficient : h.coefficients) valid = valid && std::isfinite(coefficient);
+        if (!valid) throw spexception("CUDA flux density received invalid prepared heliostat optics.");
+        packed.push_back(h);
+    }
+    output.resize(cells.size());
+    const double preparation = timing ? std::chrono::duration<double>(Clock::now()-begin).count() : 0.;
+    int block = 256;
+    bool verify = false;
+#ifdef SOLARPILOT_ENABLE_FLUX_DIAGNOSTICS
+    const char* block_text = std::getenv("SOLARPILOT_CUDA_BLOCK_SIZE");
+    if (block_text) {
+        char* end = nullptr;
+        const long value = std::strtol(block_text, &end, 10);
+        if (!end || *end || (value != 64 && value != 128 && value != 256 && value != 512))
+            throw spexception("CUDA flux block size must be 64, 128, 256 or 512");
+        block = static_cast<int>(value);
+    }
+    const char* mode = std::getenv("SOLARPILOT_FLUX_PATH");
+    verify = mode && std::strcmp(mode, "verify_cuda") == 0;
+#endif
+    if (verify && timing) throw spexception("CUDA timing requires execution without verify_cuda diagnostics.");
+    std::vector<double> reference;
+    if (verify) {
+        fluxDensityFlat(siminfo, surface, helios, tht, false);
+        std::size_t i = 0;
+        for (int x = 0; x < nx; ++x) for (int y = 0; y < ny; ++y) {
+            reference.push_back(grid.at(x).at(y).flux);
+            grid.at(x).at(y).flux = initial[i++];
+        }
+    }
+    _gpu_context->evaluate_flux(packed.data(), packed.size(), cells.data(), cells.size(), parameters, output.data(), block, timing);
+    _gpu_context->statistics.preparation_s = preparation + _gpu_context->statistics.soa_preparation_s;
+    std::size_t i = 0;
+    for (int x = 0; x < nx; ++x) for (int y = 0; y < ny; ++y) {
+        if (!std::isfinite(output[i])) throw spexception("CUDA flux density produced nonfinite output.");
+        grid.at(x).at(y).flux = initial[i]+output[i];
+        ++i;
+    }
+    if (timing) _gpu_context->statistics.hybrid_s = std::chrono::duration<double>(Clock::now()-begin).count();
+    if (progress) { siminfo->Reset(); siminfo->setCurrentSimulation(0); }
+    if (!verify) return;
+
+    // Diagnose per-pair arithmetic and sum-order error at the same raw peak cell.
+    // Bounded 256-pair tiles reuse buffers; no H*C contribution array exists.
+    const solarpilot::FluxGpuStatistics statistics = _gpu_context->statistics;
+    ErrorSummary maps, contributions;
+    std::size_t peak = 0;
+    for (std::size_t c = 0; c < cells.size(); ++c) {
+        maps.add(reference[c], initial[c]+output[c], c);
+        if (output[c] > output[peak]) peak = c;
+    }
+    double device_terms_sequential = 0.;
+    for (std::size_t first = 0; first < packed.size(); first += 256) {
+        const std::size_t count = std::min(std::size_t(256), packed.size()-first);
+        std::vector<flux_density::CellData> points(count, cells[peak]);
+        std::vector<double> values(count);
+        _gpu_context->evaluate_pairs(packed.data()+first, points.data(), count, parameters, values.data());
+        for (std::size_t h = 0; h < count; ++h) {
+            contributions.add(flux_density::evaluate_contribution(packed[first+h], points[h], parameters), values[h], first+h);
+            device_terms_sequential += values[h];
+        }
+    }
+    ErrorSummary reduction;
+    reduction.add(device_terms_sequential, output[peak], peak);
+    _gpu_context->statistics = statistics;
+    const char* path = std::getenv("SOLARPILOT_CUDA_COMPARE_FILE");
+    if (path && *path) {
+        std::ofstream out(path, std::ios::app);
+        if (!out) throw spexception("Unable to write CUDA flux comparison file.");
+        out << std::setprecision(17) << packed.size() << ',' << nx << ',' << ny << ',' << block << ','
+            << maps.absolute << ',' << maps.relative << ',' << maps.rms() << ',' << maps.abs_index/ny << ',' << maps.abs_index%ny << ','
+            << maps.rel_index/ny << ',' << maps.rel_index%ny << ',' << contributions.absolute << ',' << contributions.relative << ','
+            << contributions.rms() << ',' << contributions.abs_index << ',' << reduction.absolute << ',' << reduction.relative << ',' << peak/ny << ',' << peak%ny << ','
+            << statistics.allocations << ',' << statistics.heliostat_capacity << ',' << statistics.cell_capacity << ',' << statistics.output_capacity << '\n';
+        if (!out) throw spexception("Unable to finish CUDA flux comparison file.");
+    }
+    if (!maps.passed || !contributions.passed || !reduction.passed)
+        throw spexception("CUDA flux contribution or reduction differs beyond rtol=1e-9, atol=1e-10; inspect the comparison report.");
+}
