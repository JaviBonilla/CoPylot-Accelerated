+/* SPDX-License-Identifier: BSD-3-Clause */
+#include "Flux.h"
+#include "Heliostat.h"
+#include "Receiver.h"
+#include "CoreProfile.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iomanip>
+#include <stdexcept>
+
+void Flux::refreshImagePlaneTables() {
+    _image_tables_ready = false;
+    if (_n_terms != image_plane::terms || _mu_SN.nrows()!=7 || _mu_SN.ncols()!=7
+        || _mu_GN.nrows()!=7 || _mu_GN.ncols()!=7 || _mu_GN.nlayers()!=4) return;
+    for (int i=0; i<49; ++i) {
+        _image_tables.sun.values[i]=_mu_SN.data()[i];
+        _image_tables.binomials.values[i]=_binomials.data()[i];
+        _image_tables.binomials_hxn.values[i]=_binomials_hxn.data()[i];
+    }
+    for (int i=0; i<196; ++i) _image_tables.errors.values[i]=_mu_GN.data()[i];
+    for (int i=0; i<14; ++i) {
+        _image_tables.fact_odds[i]=_fact_odds[i];
+        _image_tables.fact_d[i]=_fact_d[i];
+    }
+    std::copy(_ci,_ci+4,_image_tables.ci);
+    std::copy(_ag,_ag+16,_image_tables.ag);
+    std::copy(_xg,_xg+16,_image_tables.xg);
+    _image_tables_ready = true;
+}
+
+bool Flux::prepareImagePlane(var_map& v, Heliostat& h, Receiver* rec, Vect* sun,
+                             image_plane::Input& in) {
+    auto* hv=h.getVarMap();
+    auto* rv=rec->getVarMap();
+    const int cant=hv->cant_method.mapval();
+    if (_n_terms!=7 || v.recs.size()!=1 || !rv->is_enabled.val
+        || rv->rec_type.mapval()!=var_receiver::REC_TYPE::EXTERNAL_CYLINDRICAL
+        || rec->getGeometryType()!=Receiver::REC_GEOM_TYPE::CYLINDRICAL_CLOSED
+        || v.flux.flux_model.mapval()!=var_fluxsim::FLUX_MODEL::HERMITE_ANALYTICAL
+        || v.flux.aim_method.mapval()!=var_fluxsim::AIM_METHOD::SIMPLE_AIM_POINTS
+        || v.flux.flux_time_type.mapval()!=var_fluxsim::FLUX_TIME_TYPE::SUN_POSITION
+        || (cant!=0 && cant!=-1 && cant!=1)) return false;
+    const int nx=hv->n_cant_x.val, ny=hv->n_cant_y.val;
+    if (hv->is_faceted.val && (nx<=0 || ny<=0 || nx>image_plane::max_facets
+        || ny>image_plane::max_facets || nx*ny>image_plane::max_facets
+        || h.getPanels()->nrows()!=size_t(ny) || h.getPanels()->ncols()!=size_t(nx))) return false;
+    if (!_image_tables_ready) refreshImagePlaneTables();
+    if (!_image_tables_ready) return false;
+    PointVect normal;
+    rec->CalculateNormalVector(*h.getLocation(),normal);
+    Vect rnorm(normal.i,normal.j,normal.k);
+    in.visible=Toolbox::dotprod(rnorm,*h.getTowerVector())<0.;
+    if (!in.visible) return true; // Legacy leaves the prior optical state intact.
+    in.tower_height=v.sf.tht.val;
+    in.radial_position=h.getRadialPos();
+    in.optical_height=rv->optical_height.Val();
+    in.diameter=Receiver::getReceiverWidth(*rv);
+    in.receiver_height=rv->rec_height.val;
+    auto track=h.getTrackVector(); auto tower=h.getTowerVector();
+    in.tracking={track->i,track->j,track->k}; in.tower={tower->i,tower->j,tower->k};
+    in.sun={sun->i,sun->j,sun->k};
+    in.angular[0]=hv->err_azimuth.val; in.angular[1]=hv->err_elevation.val;
+    in.surface[0]=hv->err_surface_x.val; in.surface[1]=hv->err_surface_y.val;
+    in.reflected[0]=hv->err_reflect_x.val; in.reflected[1]=hv->err_reflect_y.val;
+    in.focal_x=h.getFocalX(); in.focal_y=h.getFocalY();
+    in.slant_range=h.getSlantRange(); in.cant_radius=hv->cant_radius.Val();
+    in.aim_x=h.getAimPointFluxPlane()->x; in.aim_y=h.getAimPointFluxPlane()->y;
+    in.cant_method=cant; in.faceted=hv->is_faceted.val; in.facets_x=nx; in.facets_y=ny;
+    std::copy(h.getMirrorShapeNormCoefObject()->data(),h.getMirrorShapeNormCoefObject()->data()+49,in.mirror_normalized.values);
+    if (in.faceted) for (int r=0; r<ny; ++r) for (int c=0; c<nx; ++c) {
+        auto panel=h.getPanels()->at(r,c).getOrientation();
+        in.panel_x[r*nx+c]=panel->x; in.panel_y[r*nx+c]=panel->y;
+    }
+    return true;
+}
+
+void Flux::writeImagePlane(Heliostat& h, const image_plane::Output& out) {
+    if (!out.updated) return;
+    matrix_t<double>* matrices[]={h.getSunShapeCoefObject(),h.getErrorDistCoefObject(),
+        h.getMirrorShapeCoefObject(),h.getFluxMomentsObject()};
+    const image_plane::Matrix<7,7>* values[]={&out.sun,&out.errors,&out.mirror,&out.flux};
+    for (int m=0; m<4; ++m) {
+        matrices[m]->resize(7,7);
+        std::copy(values[m]->values,values[m]->values+49,matrices[m]->data());
+    }
+    h.getHermiteCoefObject()->resize(1,16);
+    std::copy(out.hermite.values,out.hermite.values+16,h.getHermiteCoefObject()->data());
+    h.setImageSize(out.sigma[0],out.sigma[1]);
+}
+
+double Flux::imagePlaneInterceptFlat(var_map& v, Heliostat& h, Receiver* rec, Vect* sun) {
+    image_plane::Input input;
+    image_plane::Output output;
+    {
+        SP_PROFILE_SCOPE(IPPrepare);
+        if (!prepareImagePlane(v,h,rec,sun,input)) return imagePlaneInterceptLegacy(v,h,rec,sun);
+    }
+    { SP_PROFILE_SCOPE(IPCore); image_plane::evaluate(input,_image_tables,output); }
+    { SP_PROFILE_SCOPE(IPWriteback); writeImagePlane(h,output); }
+    return output.intercept;
+}
+
+#ifdef SOLARPILOT_ENABLE_FLUX_DIAGNOSTICS
+namespace {
+void capture(Heliostat& h,double intercept,double (&out)[215]) {
+    int offset=0;
+    for (auto matrix : {h.getSunShapeCoefObject(),h.getErrorDistCoefObject(),h.getMirrorShapeCoefObject(),
+                       h.getFluxMomentsObject(),h.getHermiteCoefObject()}) {
+        const int size=matrix==h.getHermiteCoefObject()?16:49;
+        if (matrix->nrows()*matrix->ncols()!=size_t(size))
+            throw std::runtime_error("Image-plane verification requires initialized optical state");
+        std::copy(matrix->data(),matrix->data()+size,out+offset); offset+=size;
+    }
+    out[212]=h.getImageSize()[0]; out[213]=h.getImageSize()[1]; out[214]=intercept;
+}
+}
+#endif
+
+double Flux::imagePlaneIntercept(var_map& v, Heliostat& h, Receiver* rec, Vect* sun) {
+    SP_PROFILE_SCOPE(Intercept);
+#ifdef SOLARPILOT_ENABLE_FLUX_DIAGNOSTICS
+    const char* mode=std::getenv("SOLARPILOT_INTERCEPT_PATH");
+    if (mode && std::strcmp(mode,"legacy")==0) return imagePlaneInterceptLegacy(v,h,rec,sun);
+    if (mode && std::strcmp(mode,"verify")==0) {
+        // Both calls consume the same current H geometry; the oracle writes first.
+        double expected[215],actual[215];
+        capture(h,imagePlaneInterceptLegacy(v,h,rec,sun),expected);
+        const double result=imagePlaneInterceptFlat(v,h,rec,sun);
+        capture(h,result,actual);
+        for (int i=0; i<215; ++i) {
+            if (!std::isfinite(expected[i]) || !std::isfinite(actual[i])
+                || std::abs(expected[i]-actual[i])>1.e-10+1.e-9*std::abs(expected[i]))
+                throw std::runtime_error("Legacy/Flat image-plane optical state mismatch");
+        }
+        if (std::memcmp(expected,actual,sizeof(expected))!=0)
+            throw std::runtime_error("Legacy/Flat image-plane optical state is not bitwise identical");
+        return result;
+    }
+#endif
+    return imagePlaneInterceptFlat(v,h,rec,sun);
+}
