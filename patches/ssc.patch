+unsigned long long Flux::fluxDensityFlat(simulation_info* siminfo, FluxSurface& surface, Hvector& helios, double tht, bool progress)
+{
+    const int nx = surface.getFluxNX(), ny = surface.getFluxNY();
+    FluxGrid& grid = *surface.getFluxMap();
+    var_receiver* variables = surface.getParent()->getVarMap();
+    const sp_point& offset = *surface.getSurfaceOffset();
+    const sp_point receiver_offset(variables->rec_offset_x_global.Val(), variables->rec_offset_y_global.Val(), variables->rec_offset_z_global.Val());
+    const bool aperture = variables->rec_type.mapval() == var_receiver::REC_TYPE::FALLING_PARTICLE
+        || variables->rec_type.mapval() == var_receiver::REC_TYPE::CAVITY;
+    const flux_density::Parameters parameters = {tht, pi};
+    std::vector<flux_density::CellData> cells;
+    std::vector<double> accumulator;
+    cells.reserve(size_t(nx)*ny); accumulator.reserve(size_t(nx)*ny);
+    for (int x = 0; x < nx; ++x)
+        for (int y = 0; y < ny; ++y) {
+            const FluxPoint& point = grid.at(x).at(y);
+            const flux_density::CellData cell = {
+                {point.location.x + offset.x + receiver_offset.x,
+                 point.location.y + offset.y + receiver_offset.y,
+                 point.location.z + offset.z + receiver_offset.z + tht},
+                {point.normal.i, point.normal.j, point.normal.k}};
+            cells.push_back(cell); accumulator.push_back(point.flux);
+        }
+    const int count = static_cast<int>(helios.size()), update_every = max(count/20, 1);
+    if (progress) siminfo->setTotalSimulationCount(count);
+    unsigned long long evaluated = 0;
+    for (int i = 0; i < count; ++i) {
+        if (progress && i % update_every == 0) siminfo->setCurrentSimulation(i+1);
+        Heliostat* source = helios.at(i);
+        if (!source->IsEnabled()) continue;
+        flux_density::HeliostatData h;
+        source->getImageSize(h.sigma_x, h.sigma_y);
+        const sp_point& aim = *source->getAimPoint();
+        sp_point* location = source->getLocation();
+        Vect direction(location->x-receiver_offset.x, location->y-receiver_offset.y, location->z-receiver_offset.z-tht);
+        Toolbox::unitvect(direction);
+        h.direction[0] = direction.i; h.direction[1] = direction.j; h.direction[2] = direction.k;
+        h.aim[0] = aim.x; h.aim[1] = aim.y; h.aim[2] = aim.z;
+        h.normalization = source->getArea()*source->getEfficiencyTotal()/(tht*tht);
+        for (int term = 0; term < 16; ++term) h.coefficients[term] = source->getHermiteCoefObject()->at(term);
+        for (size_t cell = 0; cell < cells.size(); ++cell) {
+            const double cosine = flux_density::visibility_cosine(h, cells[cell]);
+            if (cosine < 0. || cosine > 1.) continue;
+            if (aperture) {
+                sp_point global(cells[cell].position[0], cells[cell].position[1], cells[cell].position[2]);
+                if (!checkApertureSnout(global, location, source->getAimPoint(), variables)) continue;
+            }
+#ifdef SOLARPILOT_ENABLE_FLUX_DIAGNOSTICS
+            ++evaluated;
+#endif
+            accumulator[cell] += flux_density::evaluate_contribution(h, cells[cell], parameters);
+        }
+    }
+    size_t cell = 0;
+    for (int x = 0; x < nx; ++x)
+        for (int y = 0; y < ny; ++y) grid.at(x).at(y).flux = accumulator.at(cell++);
+    if (progress) { siminfo->Reset(); siminfo->setCurrentSimulation(0); }
+    return evaluated;
+}
