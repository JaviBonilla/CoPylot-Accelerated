+void resolve_project_weather(var_map& v, const std::string& project) {
+    const std::string stored=v.amb.weather_file.val;
+    if (stored.empty() || ioutil::file_exists(stored.c_str())) return;
+    const bool absolute=project[0]=='/' || project[0]=='\\' || (project.size()>1 && project[1]==':');
+    const std::string full=absolute?project:ioutil::get_cwd()+ioutil::path_separator()+project;
+    const auto end=full.find_last_of("/\\");
+    const std::string directory=full.substr(0,end+1);
+    const bool relative=stored[0]!='/' && stored[0]!='\\' && !(stored.size()>1 && stored[1]==':');
+    if (relative && ioutil::file_exists((directory+stored).c_str())) {
+        v.amb.weather_file.val=directory+stored;
+        return;
+    }
+    const std::string beside=directory+ioutil::name_only(stored);
+    if (ioutil::file_exists(beside.c_str())) v.amb.weather_file.val=beside;
+}
+
+void validate_serialized_layout(var_map& v) {
+    unsigned receivers=0;
+    for (auto& rec:v.recs) if (rec.is_enabled.val) ++receivers;
+    if (receivers!=1) throw std::runtime_error("Serialized restoration requires one enabled receiver.");
+    if (v.sf.layout_data.val.empty()) throw std::runtime_error("Serialized layout is empty.");
+    auto rows=split(v.sf.layout_data.val,";");
+    if (rows.size()<2) rows=split(v.sf.layout_data.val,"\n");
+    unsigned count=0, width=0;
+    for (auto row:rows) {
+        if (row.find_first_not_of(" \r\n\t")==std::string::npos) continue;
+        auto columns=split(row,Toolbox::getDelimiter(row));
+        if (columns.size()!=12 && columns.size()!=14)
+            throw std::runtime_error("Serialized layout requires complete 12- or 14-column rows.");
+        if (width && width!=columns.size()) throw std::runtime_error("Serialized layout mixes row formats.");
+        width=columns.size();
+        const unsigned offset=columns.size()==14?2:0;
+        auto number=[&](unsigned i) {
+            char* end=nullptr;
+            const double value=std::strtod(columns[i].c_str(),&end);
+            while (end && *end && std::isspace(static_cast<unsigned char>(*end))) ++end;
+            if (end==columns[i].c_str() || !end || *end || !std::isfinite(value))
+                throw std::runtime_error("Serialized layout contains an invalid numeric value.");
+            return value;
+        };
+        const double id=number(0);
+        bool found=false;
+        for (auto& h:v.hels) if (h.id.val==id) found=true;
+        if (!found) throw std::runtime_error("Serialized layout references a missing heliostat template.");
+        if (offset) for (unsigned i=1;i<3;++i) {
+            const std::string flag=lower_case(columns[i]);
+            if (flag!="0" && flag!="1" && flag!="false" && flag!="true" && flag!="f" && flag!="t")
+                throw std::runtime_error("Invalid serialized enabled/layout flag.");
+        }
+        for (unsigned i=1+offset;i<4+offset;++i) number(i);
+        for (auto group: {std::pair<unsigned,unsigned>(4+offset,2),{6+offset,3},{9+offset,3}}) {
+            const bool missing=columns[group.first]=="NULL";
+            for (unsigned i=group.first;i<group.first+group.second;++i) {
+                if (missing ? columns[i]!="NULL" : columns[i]=="NULL")
+                    throw std::runtime_error("Serialized layout contains a partial optional geometry group.");
+                if (!missing) {
+                    const double value=number(i);
+                    if (group.first==4+offset && value<=0.)
+                        throw std::runtime_error("Serialized focal lengths must be positive.");
+                }
+            }
+        }
+        ++count;
+    }
+    if (!count) throw std::runtime_error("Serialized layout is empty.");
+}
+}
