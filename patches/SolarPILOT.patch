+        self.pdll.sp_set_cuda_device.restype = c_bool
+        self.pdll.sp_set_cuda_device.argtypes = [c_void_p, c_int]
+        ok = self.pdll.sp_set_cuda_device(c_void_p(p_data), device)
+        if not ok:
+            raise RuntimeError(self.get_last_backend_error(p_data))
+        return True
