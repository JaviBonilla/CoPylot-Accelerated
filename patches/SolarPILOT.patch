Subject: [PATCH 1/2] feat: expose compute backend and CUDA probe through
 CoPylot API

---
 deploy/api/copylot.py | 61 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 61 insertions(+)

diff --git a/deploy/api/copylot.py b/deploy/api/copylot.py
index c51f275..7c61195 100644
--- a/deploy/api/copylot.py
+++ b/deploy/api/copylot.py
@@ -716,6 +716,67 @@ class CoPylot:
                 df.set_index(header[0])
                 return df
 
+    def _cuda_probe_error(self):
+        self.pdll.sp_cuda_last_error.restype = c_char_p
+        self.pdll.sp_cuda_last_error.argtypes = []
+        error = self.pdll.sp_cuda_last_error().decode()
+        if error:
+            raise RuntimeError(error)
+
+    def cuda_available(self) -> bool:
+        """Whether this build can see a CUDA device; runtime errors are explicit."""
+        self.pdll.sp_cuda_available.restype = c_bool
+        self.pdll.sp_cuda_available.argtypes = []
+        available = bool(self.pdll.sp_cuda_available())
+        self._cuda_probe_error()
+        return available
+
+    def cuda_device_count(self) -> int:
+        """Zero for CPU-only/no devices; raises on driver/runtime failure."""
+        self.pdll.sp_cuda_device_count.restype = c_int
+        self.pdll.sp_cuda_device_count.argtypes = []
+        count = self.pdll.sp_cuda_device_count()
+        self._cuda_probe_error()
+        if count < 0:
+            raise RuntimeError("CUDA device enumeration failed")
+        return count
+
+    def get_last_backend_error(self, p_data: int) -> str:
+        self.pdll.sp_get_last_backend_error.restype = c_char_p
+        self.pdll.sp_get_last_backend_error.argtypes = [c_void_p]
+        return self.pdll.sp_get_last_backend_error(c_void_p(p_data)).decode()
+
+    def set_compute_backend(self, p_data: int, backend: str) -> bool:
+        """Select CPU. CUDA raises until the numerical backend is implemented."""
+        backends = {"cpu": 0, "cuda": 1}
+        if not isinstance(backend, str) or backend.lower() not in backends:
+            raise ValueError("Compute backend must be 'cpu' or 'cuda'")
+        self.pdll.sp_set_compute_backend.restype = c_bool
+        self.pdll.sp_set_compute_backend.argtypes = [c_void_p, c_int]
+        ok = self.pdll.sp_set_compute_backend(c_void_p(p_data), backends[backend.lower()])
+        if not ok:
+            raise RuntimeError(self.get_last_backend_error(p_data))
+        return True
+
+    def get_compute_backend(self, p_data: int) -> str:
+        self.pdll.sp_get_compute_backend.restype = c_int
+        self.pdll.sp_get_compute_backend.argtypes = [c_void_p]
+        selected = self.pdll.sp_get_compute_backend(c_void_p(p_data))
+        if selected not in (0, 1):
+            raise RuntimeError("Invalid or null CoPylot context")
+        return {0: "cpu", 1: "cuda"}[selected]
+
+    def set_cuda_device(self, p_data: int, device: int) -> bool:
+        """Validate device/toolchain with a trivial kernel; no optical GPU work."""
+        if not isinstance(device, int) or isinstance(device, bool) or device < 0:
+            raise ValueError("CUDA device must be a nonnegative integer")
+        self.pdll.sp_set_cuda_device.restype = c_bool
+        self.pdll.sp_set_cuda_device.argtypes = [c_void_p, c_int]
+        ok = self.pdll.sp_set_cuda_device(c_void_p(p_data), device)
+        if not ok:
+            raise RuntimeError(self.get_last_backend_error(p_data))
+        return True
+
