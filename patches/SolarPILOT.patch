     #SPEXPORT bool sp_save_from_script(sp_data_t p_data, const char* sp_fname)
+    def _spt_file(self, p_data: int, filename: Union[str, os.PathLike], operation: str) -> bool:
+        """Call the existing C serializer with checked arguments and errors."""
+        if not p_data:
+            raise ValueError('SPT operations require a live CoPylot context')
+        path = os.fspath(filename)
+        if not isinstance(path, str):
+            raise TypeError('SPT filename must be str or a PathLike returning str')
+        if not path or '\0' in path:
+            raise ValueError('SPT filename must be nonempty and contain no NUL characters')
+        # The existing C saver requires a parent directory, even for a basename.
+        path = os.path.abspath(path)
+        function = getattr(self.pdll, 'sp_' + operation + '_from_script')
+        function.restype = c_bool
+        function.argtypes = [c_void_p, c_char_p]
+        if not function(c_void_p(p_data), os.fsencode(path)):
+            detail = self.get_last_backend_error(p_data)
+            raise RuntimeError(f'Failed to {operation} SPT {path!r}: {detail or "C API returned false"}')
+        return True
+
+    def save_spt(self, p_data: int, filename: Union[str, os.PathLike]) -> bool:
+        """Save project variables using the existing SolarPILOT SPT serializer.
+
+        Accepts str and PathLike filenames, relative to the current directory.
+        Returns True on success; raises RuntimeError on a C serialization or
+        filesystem failure. No runtime results or backend state are serialized.
+        The context remains owned by the caller. Existing files are overwritten.
+        """
+        return self._spt_file(p_data, filename, 'save')
+
+    def load_spt(self, p_data: int, filename: Union[str, os.PathLike]) -> bool:
+        """Load project variables using the existing SolarPILOT SPT parser.
+
+        Accepts str and PathLike filenames; returns True or raises RuntimeError.
+        Templates, receiver definitions, layout text and weather inputs are
+        restored, but the runtime field and previous results are cleared. Prepare
+        the layout before simulating (generate_layout reads the external weather
+        file). A fresh context is recommended; discard it after a failed load.
+        Backend selection and context ownership remain with the caller.
+        """
+        return self._spt_file(p_data, filename, 'load')
+
     def save_from_script(self, p_data: int, sp_fname: str) -> bool:
         """Save the current case as a SolarPILOT .spt file
 
@@ -1313,6 +1355,7 @@ class CoPylot:
         """
 
         self.pdll.sp_save_from_script.restype = c_bool
